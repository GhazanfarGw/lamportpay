# LamportPay environment example
#
# JUPITER_API_KEY and PAYOUT_API_KEY must only be used on the backend (server routes / server functions).
# Never expose JUPITER_API_KEY or PAYOUT_API_KEY in frontend code or any VITE_/NEXT_PUBLIC_ variable.
# Never ask users for their seed phrase.
# Never ask users for their private key.
# Payout partner API is optionally enabled by adding a real PAYOUT_API_KEY. When missing, payout partner endpoints return demo-mode responses.
# Fiat payout is intentionally disabled for now.
# Real KYC is intentionally disabled for now.
#
# If JUPITER_API_KEY is missing, the API routes return: "Missing Jupiter API key."
# If PAYOUT_API_KEY is missing, the Payout partner API routes return a 503 demo-mode response.

JUPITER_API_KEY=
PAYOUT_API_KEY=
# Optional: sandbox or production URL. Provided by your regulated payout partner.
PAYOUT_API_URL=
# Optional: PEM public key your payout partner assigns to your webhook endpoint for signature verification.
PAYOUT_WEBHOOK_SECRET=

# Required to allow ANY call to /api/payout/* (customer, external-account, quote, transfer).
# Server-only secret, min 24 chars. Requests must send it as `x-payout-operator-token`
# (or `Authorization: Bearer <token>`). When unset, all payout routes reject with 403.
PAYOUT_OPERATOR_TOKEN=

# Public (safe to expose) — Solana network used by the wallet provider.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Optional: custom Solana RPC endpoints used by /api/solana/health and /api/solana/verify-tx.
# Defaults to the public Solana endpoints. These are read server-side only.
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_TESTNET_RPC_URL=
