# LamportPay environment example
#
# JUPITER_API_KEY, STABLES_API_KEY and STABLES_WEBHOOK_SECRET are server-only.
# Never expose them in frontend code or any VITE_/NEXT_PUBLIC_ variable.
# Never ask users for their seed phrase.
# Never ask users for their private key.
#
# If JUPITER_API_KEY is missing, swap routes answer 503 "Swaps are not configured." (no mock).
# Every Jupiter route needs a signed-in user.

JUPITER_API_KEY=

# Stables (KYC/KYB, USDC/USDT → fiat conversion and payout to the user's own bank
# account). LamportPay is non-custodial: users send USDC or USDT on Solana from their own
# wallet to the single-use deposit address Stables returns per transfer.
# Without STABLES_API_KEY the /api/kyc and /api/payments routes return 503.
# Sandbox keys start with sti_test_, production keys with sti_live_; a key that does
# not match STABLES_API_URL is refused. In the sandbox, on-chain funding is disabled
# (sandbox deposit addresses are not real); an admin simulates the deposit instead,
# which is refused with a live key.
STABLES_API_KEY=
# Defaults to the sandbox. Production: https://api.stables.money
STABLES_API_URL=https://api.sandbox.stables.money
# Webhook signing secret: the whsec_… secret of the endpoint registered in the Stables
# dashboard (Svix-signed deliveries only; X-Webhook-Signature is not accepted).
# Endpoint: POST /api/public/stables-webhook. Unset → signed deliveries get 503 (Stables
# retries); unsigned or badly signed requests always get 401.
# Locally, put it in .env.local (overrides .env; restart the dev server after changing it).
# Local tunnel and test events: docs/stables-sandbox-runbook.md.
STABLES_WEBHOOK_SECRET=
# Per-payment limits per stablecoin (defaults: min 100, max 1000000 for each).
# PAYMENT_MAX_*=none: no LamportPay maximum; Stables' per-customer limits decide (owner decision).
# Changing .env needs a dev server restart; on Vercel, a redeploy.
PAYMENT_MIN_USDC=
PAYMENT_MAX_USDC=
PAYMENT_MIN_USDT=
PAYMENT_MAX_USDT=

# Required by the payment routes (server-side Supabase access). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Public (safe to expose) — Solana network used by the wallet provider.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Optional: custom Solana RPC endpoints used by /api/solana/health and /api/solana/verify-tx,
# and (mainnet) for reading wallet balances and confirming deposits and swaps.
# Defaults to the public Solana endpoints. These are read server-side only.
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_TESTNET_RPC_URL=

# Optional: wallet settlement and payment swaps (docs/wallet-settlement-design.md).
# SOL a payer must keep on top of fees and rent, in lamports (default 2000000 = 0.002 SOL).
SOLANA_FEE_RESERVE_LAMPORTS=
# Swap sizing and refusal limits, in basis points (defaults 50, 100, 100).
SWAP_SIZE_BUFFER_BPS=
SWAP_MAX_SLIPPAGE_BPS=
SWAP_MAX_PRICE_IMPACT_BPS=

# Supabase (client + server)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Bearer secret for cron-triggered endpoints (see src/integrations/supabase/cron-auth.ts).
# Required by GET|POST /api/cron/reconcile-payments, which catches up on missed Stables
# webhooks. Vercel Cron sends it automatically when this variable is set.
CRON_SECRET=
# Build-time: Vercel Cron schedule for payment reconciliation. Default "0 5 * * *" (daily,
# the most Hobby plans allow); e.g. "*/10 * * * *" on Pro.
RECONCILE_CRON_SCHEDULE=

# Usual time (minutes) for a bank payout to arrive once the partner has the funds.
# Shown to users as an estimate only; never changes a payment state. Default 60.
PAYOUT_ESTIMATE_MINUTES=

# --- LamportPay revenue (Phase 3). Defaults; admins can override them in the admin dashboard.
# The ONE total LamportPay fee in basis points (200 = 2%), added on top of the Stables quote and
# paid in the same user-signed transaction to the revenue wallet. Unset = no fee.
LAMPORTPAY_FEE_BPS=
# Separate Jupiter swap fee: must stay 0 (owner decision 2026-09-30: one total fee, never 2% + 2%).
LAMPORTPAY_SWAP_FEE_BPS=
# Public Solana address of the company revenue wallet (receives LamportPay's fee only).
LAMPORTPAY_REVENUE_WALLET=
# Jupiter referral account (created by the company wallet at referral.jup.ag). Public address.
JUPITER_REFERRAL_ACCOUNT=
# Payment coins turned on, comma separated (usdc,usdt). Unset = both.
PAYMENT_ENABLED_CURRENCIES=

# ---------------------------------------------------------------------------
# TEST MODE / LIVE MODE (docs/security/test-live-mode.md)
# The mode belongs to the DEPLOYMENT. A test deployment and a live deployment
# are separate apps with separate .env files; nothing in the browser switches it.
# TEST (default): Solana devnet + faucet test assets, Stables sandbox (sti_test_
#   key), dev database. Production endpoints are refused by the server.
# LIVE: mainnet, production Stables (never a sti_test_ key), production database.
#   Stays DISABLED until the code lock (src/lib/app-mode-lock.ts) is opened in a
#   reviewed commit AND the owner approval below is recorded.
LAMPORTPAY_MODE=test
VITE_LAMPORTPAY_MODE=test
# Test deployment only: devnet RPC (optional; public devnet by default).
SOLANA_DEVNET_RPC_URL=
# Live deployment only:
LAMPORTPAY_LIVE_APPROVED_BY=
LAMPORTPAY_LIVE_APPROVED_AT=
LAMPORTPAY_LIVE_URL=
# Optional: where "Switch to TEST MODE" goes from the live app.
LAMPORTPAY_TEST_URL=
